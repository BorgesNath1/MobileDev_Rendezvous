rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    // Perfil: só o próprio usuário lê e escreve
    match /users/{userId} {
      allow read, write: if logado() && request.auth.uid == userId;
    }

    // Encontros: só quem está em membrosUids (dono + convidados) enxerga
    match /eventos/{eventoId} {
      allow read: if logado() && request.auth.uid in resource.data.membrosUids;

      // Quem cria é o dono e precisa estar na lista de membros
      allow create: if logado()
        && request.resource.data.donoUid == request.auth.uid
        && request.auth.uid in request.resource.data.membrosUids;

      // Dono: altera o que quiser (sem trocar o dono).
      // Convidado: só o próprio status no mapa convidados e o status do encontro
      // (a confirmação automática quando todos confirmam).
      allow update: if logado() && (
        (resource.data.donoUid == request.auth.uid
          && request.resource.data.donoUid == resource.data.donoUid)
        || (request.auth.uid in resource.data.membrosUids
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['convidados', 'status'])
          && request.resource.data.convidados.diff(resource.data.convidados).affectedKeys().hasOnly([request.auth.uid]))
      );

      allow delete: if logado() && resource.data.donoUid == request.auth.uid;
    }
  }
}
